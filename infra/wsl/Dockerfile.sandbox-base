# Computation image contains public Python/Pillow dependencies only.
# No repository, account configuration, environment file or bot data is copied.
FROM python:3.12.3-slim@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63

RUN python -m pip install --no-cache-dir Pillow==11.3.0

USER 65534:65534
WORKDIR /outputs
