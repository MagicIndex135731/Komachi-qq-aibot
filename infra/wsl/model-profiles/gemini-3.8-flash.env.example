# Provider overlay only. Copy into ignored runtime/model-profiles/gemini.env.
# Populate private credentials and merge remaining model defaults via the CLI.
LLM_BASE_URL=https://gemini-relay.example/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash-medium
LLM_VISION_MODEL=gemini-3.8-flash-medium
LLM_FALLBACK_MODEL=
LLM_TEXT_ENDPOINT=responses
LLM_REASONING_EFFORT=medium
LLM_BUILTIN_WEB_SEARCH=false
PROACTIVE_JUDGE_MODEL=gemini-3.8-flash-low
PROACTIVE_JUDGE_REASONING_EFFORT=low
MEMORY_COMPACTION_REASONING_EFFORT=low
MEMORY_EPISODE_TOPIC_JUDGE_REASONING_EFFORT=low
MEMORY_EPISODE_POST_SEGMENT_REASONING_EFFORT=low
# Independent native Google Search; search effort stays medium when chat switches.
SEARCH_PROVIDER=gemini
SEARCH_BASE_URL=https://gemini-relay.example/v1
SEARCH_API_KEY=
LLM_WEB_SEARCH_MODEL=gemini-3.8-flash-medium
LLM_WEB_SEARCH_API_KEY=
WEB_SEARCH_REASONING_EFFORT=medium
GROUP_IMAGE_TRANSPORT=images
GROUP_IMAGE_BASE_URL=https://gemini-relay.example/v1
GROUP_IMAGE_API_KEY=
GROUP_IMAGE_CHAT_BASE_URL=
GROUP_IMAGE_CHAT_API_KEY=
GROUP_IMAGE_MODEL=gemini-3.1-flash-image
GROUP_IMAGE_EDIT_MODEL=
GROUP_IMAGE_RESPONSES_MODEL=
GROUP_IMAGE_GENERATIONS_ENDPOINT=/images/generations
GROUP_IMAGE_EDITS_ENDPOINT=/images/edits
GROUP_IMAGE_SIZE=1024x1024
GROUP_IMAGE_QUALITY=medium
GROUP_IMAGE_OUTPUT_FORMAT=jpeg
GROUP_IMAGE_TIMEOUT_SECONDS=900
