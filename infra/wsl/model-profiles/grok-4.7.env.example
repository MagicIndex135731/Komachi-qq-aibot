# Overlay these non-secret values into the existing private .env.
# Set LLM_API_KEY privately to the Grok key, and LLM_WEB_SEARCH_API_KEY
# to the existing verified Wyzlab alpha-search key. Keep the image key intact.
LLM_MODEL=grok-4.7
LLM_FALLBACK_MODEL=
LLM_TEXT_ENDPOINT=responses
LLM_REASONING_EFFORT=low
LLM_VISION_MODEL=grok-4.7
LLM_SUPPORTS_VISION_INPUT=true
LLM_MAX_OUTPUT_TOKENS=8192
LLM_BUILTIN_WEB_SEARCH=false
LLM_WEB_SEARCH_MODEL=gpt-6.1-sol
WEB_SEARCH_REASONING_EFFORT=low
PROACTIVE_JUDGE_MODEL=grok-4.7
PROACTIVE_JUDGE_REASONING_EFFORT=low
PROACTIVE_JUDGE_MAX_OUTPUT_TOKENS=1024
MEMORY_EPISODE_TOPIC_JUDGE_REASONING_EFFORT=low
MEMORY_EPISODE_TOPIC_JUDGE_MAX_OUTPUT_TOKENS=512
MEMORY_EPISODE_POST_SEGMENT_REASONING_EFFORT=low
MEMORY_EPISODE_POST_SEGMENT_MAX_OUTPUT_TOKENS=2048
MEMORY_COMPACTION_REASONING_EFFORT=low
# Image generation/editing stays on its independent verified images transport.
GROUP_IMAGE_TRANSPORT=images
GROUP_IMAGE_MODEL=gpt-image-2
